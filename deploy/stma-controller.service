[Unit]
Description=STMA Multi-Account Trading Controller Daemon
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/stma
ExecStart=/opt/stma/venv/bin/python -m uvicorn controller.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
Environment="PATH=/opt/stma/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONPATH=/opt/stma"
Environment="STMA_SERVER_HOST=0.0.0.0"
Environment="STMA_SERVER_PORT=8000"

# Security sandboxing
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
